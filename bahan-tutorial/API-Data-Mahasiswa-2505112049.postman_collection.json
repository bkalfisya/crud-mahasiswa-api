    {
      "name": "1. Login",
      "item": [
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Ada token di body\", function () {",
                  "    var isi = pm.response.json();",
                  "    pm.expect(isi.token).to.have.lengthOf(64);",
                  "    pm.collectionVariables.set(\"token_admin\", isi.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{url}}/login",
              "host": [
                "{{url}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        },
